# Supabase Postgres (direct/pooler connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_TG_ID=

# Backend
FLEET_BACKEND_URL=
RUNNER_TOKEN=

# Shared auth secret — set the SAME value in all three:
#   fleet-backend env: RUNNER_SECRET
#   receiver env:      FLEET_TOKEN
#   runner .env:       RUNNER_TOKEN
# Empty everywhere = auth disabled (dev only).
RUNNER_SECRET=

# Docker runner env — copy to runner/.env and fill.
# Points at the DOCKER backend (the operator's isolated stack), NOT the owner's fleet backend.
FLEET_BACKEND_HTTP=https://YOUR-docker-backend.up.railway.app
FLEET_BACKEND_WS=wss://YOUR-docker-backend.up.railway.app/ws/runner
MACHINE_NAME=docker
# MUST equal RUNNER_SECRET on the Docker backend (shared secret: WS ?token= + X-Fleet-Token).
RUNNER_TOKEN=set-a-strong-shared-secret
